# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤, 키를 직접 붙여넣으세요.
# .env 파일은 절대 채팅·깃허브에 올리지 마세요. (.gitignore에 이미 제외돼 있어요)

# 2단계(초안 작성)에서 사용
ANTHROPIC_API_KEY=

# 배경 이미지 생성(gen-bg.js)에서 사용
OPENAI_API_KEY=

# 렌더링이 끝나면 사진+캡션을 디스코드 채널로 자동 전송 (채널 설정 → 연동 → 웹후크 URL)
DISCORD_WEBHOOK_URL=

# 영거진 스튜디오 (선택)
# STUDIO_PIN=1234                 # 접속 PIN
# STUDIO_PUBLIC_URL=https://desktop-krlmcko.xxxx.ts.net   # 디스코드 알림에 넣을 링크
# BG_DAILY_LIMIT=5                # 스튜디오 배경 생성 하루 상한

# 선택 설정 (비워두면 기본값)
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_SIZE=1088x1360
# OPENAI_IMAGE_QUALITY=medium
